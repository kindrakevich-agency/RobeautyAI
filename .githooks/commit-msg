#!/bin/sh
# Жодних згадок про інструменти в історії репозиторію — правило замовника.
# Разова перевірка вже підводила: трейлер потрапив в один коміт із 94 і
# спливнув на сторінці учасників GitHub.
#
# Шукаємо саме ТРЕЙЛЕР на початку рядка, а не будь-яку згадку в тексті:
# інакше коміт, який описує цю ж проблему, не пройде сам себе.
if grep -qiE '^(Co-Authored-By|Signed-off-by):.*(claude|anthropic)|^.*Generated with .*Claude' "$1"; then
  echo "Коміт відхилено: у повідомленні трейлер зі згадкою Claude/Anthropic." >&2
  echo "Приберіть його — це домовленість щодо цього репозиторію." >&2
  exit 1
fi
