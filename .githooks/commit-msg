#!/bin/sh
# Жодних згадок про інструменти в історії репозиторію — правило замовника.
# Разова перевірка вже підводила: трейлер потрапив в один коміт із 94 і
# спливнув на сторінці учасників GitHub. Тому перевірка тепер автоматична.
if grep -qiE '^(Co-Authored-By:.*)?(claude|anthropic)|generated with .*claude' "$1"; then
  echo "✗ Коміт відхилено: у повідомленні є згадка про Claude/Anthropic." >&2
  echo "  Приберіть її — це домовленість щодо цього репозиторію." >&2
  exit 1
fi
